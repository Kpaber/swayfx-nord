			"keyColor": "green",
		},		
		{
			"type": "disk",
			"key": "|  disk   |",
			"keyColor": "yellow",
		},
		"separator",
		{
			"type": "colors",
			"key": "|  colors |",
			"keyColor": "magenta",
			"symbol": "circle",
		},
		"separator",
		
	],
}

		
