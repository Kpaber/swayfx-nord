# Игнорировать регистр букв при поиске совпадений (cd dow<Tab> -> cd Downloads/)
set completion-ignore-case on

# Считать дефис (-) и нижнее подчеркивание (_) эквивалентными при комплите.
# Работает только когда включен completion-ignore-case (my-script == my_script)
set completion-map-case on

# Показывать список вариантов сразу по первому нажатию Tab, если вариантов несколько
# (по дефолту Bash сначала просто пищит и ждет второго нажатия Tab)
set show-all-if-ambiguous on

# То же самое, но для случаев, когда у вариантов нет общего префикса для подстановки
#set show-all-if-unmodified on

# Автоматически дописывать слэш (/) к имени директории при автодополнении
set mark-directories on

# Автоматически дописывать слэш (/) к симлинкам, которые ведут на директории
# (без этого при комплите симлинка приходится жать Tab дважды)
set mark-symlinked-directories on

# Не показывать скрытые файлы (начинающиеся с точки), если ты явно не ввел "."
# Сильно очищает выдачу при нажатии Tab в домашней директории
set match-hidden-files on

# Умный комплит в середине слова: если курсор стоит внутри слова (например, пут|ь),
# нажатие Tab дополнит слово, не дублируя его правую часть (не сделает "путьь")
set skip-completed-text on

# При циклическом переборе по Tab сначала подставлять общую часть всех вариантов,
# и только со следующего нажатия начинать перебирать конкретные файлы по очереди
set menu-complete-display-prefix on

# Порог количества вариантов, после которого Readline спросит "Display all X possibilities?"
#set completion-query-items 150

# Отключить встроенный постраничный пейджер (--More--) при длинном списке комплита,
# чтобы список просто выводился в буфер скролла терминала
set page-completions off

# Раскрашивать файлы и папки в списке автодополнения по их типам (берет цвета из LS_COLORS)
set colored-stats on

# Подсвечивать цветом ту часть префикса, которую ты уже ввел, внутри списка вариантов
#set colored-completion-prefix on

# Добавлять символ типа файла в конец имени при комплите (* для исполняемых, @ для симлинков и т.д.)
# (По умолчанию выключено, так как colored-stats обычно достаточно и выглядит чище)
# set visible-stats on

# Полностью отключить звуковой и визуальный писк (bell) при ошибках ввода или комплита
#set bell-style none

# Защита при вставке из буфера обмена (Bracketed Paste Mode):
# Вставленный многострочный текст не будет выполняться построчно как команды,
# пока ты сам явно не нажмешь Enter
set enable-bracketed-paste on

# Если ввести "git " и нажать Стрелку Вверх — будут листаться ТОЛЬКО команды на "git "
"\e[A": history-search-backward
"\e[B": history-search-forward

# Вместо простого вывода списка каждое нажатие Tab подставляет следующий вариант в строку
# (благодаря menu-complete-display-prefix выше — сначала покажет список, затем начнет перебор)
TAB: menu-complete
"\e[Z": menu-complete-backward



