[
	{
		"output": "eDP-1",
		"ipc": "true",
		"id": "bar-0",
		"exclusive": "false",
		"layer": "top",
				
		"height": 1,
/*		"margin-top": 8,
		"margin-left": 12,
		"margin-right": 12,*/
		
		"modules-left": [
			"custom/logo", 
			"sway/workspaces",
			],
		"modules-center": [
			"clock",
			"custom/weather",
			],
		"modules-right": [
			"tray",
			"wireplumber",
			"backlight",
			"sway/language",
			"bluetooth",
			"network",
			"battery",			
			"custom/power",
		],
		"custom/logo": {
			"format": "",
			"on-click": "rofi -show drun -location 1 -theme $HOME/.config/rofi/themes/drun.rasi",
			"tooltip": false,
		},
		"sway/workspaces": {
			"disable-scroll": true,
			"all-outputs": true,
			"format": "{icon}",
			"format-icons": {
				"default": "󰝥",
				"focused": "󰜗",
			}
		},
		"custom/weather": {
			"exec": "weather.sh",
			"return-type": "json",
			"interval": 1800,
			"tooltip": true,
		},
		"clock": {
			"interval": 1,
			"format": "󰥔 {:%H:%M}",
			"tooltip-format": "<tt><small>{calendar}</small></tt>",
    		"calendar": {
        		"mode": "month",
        		"format": {
        			"today": "<u>{}</u>",	
        		},
           	},
		},
		"battery": {
			"format": "{icon} {capacity}%",
			"format-charging": "󱐋 {capacity}%",
/*			"format-plugged": "󱐋 {capacity}%", */
			"format-icons": ["", "", "", "", ""],
		    "tooltip-format": "Осталось: {time}\nМощность: {power} W",
		    "on-click": "xfce4-power-manager-settings",
		},
		"wireplumber": {
			"format": "{icon} {volume}%",
			"format-muted": "󰝟",
			"format-icons": ["", "", ""],
			"on-click": "pavucontrol",
			"on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
		},
		"backlight": {
			"scroll-step": 1,
			"format": "{icon} {percent}%",
			"format-icons": ["", "󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"],
			"tooltip": false,
		},
		"sway/language": {
			"format": "{}",
			"tooltip": false,
		},
		"network": {
			"format-wifi": "󰖩",
			"format-disconnected": "",
    		"format-ethernet": "󰈀",
    		"tooltip-format": "Интерфейс: {ifname}\nШлюз: {gwaddr}",
    		"tooltip-format-wifi": "Сеть: <b>{essid}</b> ({signalStrength}%)\nIP: {ipaddr}/{cidr}\nЧастота: {frequency} GHz",
			"on-click": "iwgtk"
		},
		"bluetooth": {
			"format": "",
			"format-disabled": "󰂲", // an empty format will hide the module
			"format-connected": " {num_connections} connected",
			"tooltip-format": "{controller_alias}\t{controller_address}",
			"tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
			"tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
			"on-click": "blueman-manager"
		},		
		"custom/power": {
			"format": "⏻",
			"on-click": "power.sh",
			"tooltip": false,
		},
		"tray": {
			"icon-size": 18,
			"spacing": 4
		}
	}
]


