{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",	
	"logo": {
	"padding": {
			"top": 1,
			"left": 1,
		},
/*		"color":{
			"2": "white",
			"1": "red",
		},*/
		"type": "sixel",
//		"preserveAspectRatio": "true",
		"source": "~/.config/fastfetch/logo.png",
		"width": 18,
	},
	"display": {
		"separator": " ~ ",
	},
	"modules": [	
		"separator",
		{
			"type": "title",
			"key": "|  user   |",
			"keyColor": "cyan",
			"format": "{user-name}",	
		},

		{
			"type": "host",
			"key": "| 󰍹 host   |",
			"keyColor": "blue",
		},
		{
			"type": "uptime",
			"key": "| 󰅐 uptime |",
			"keyColor": "green",	
		},
		{
			"type": "os",
			"key": "|  distro |",
			"keyColor": "red",
		},
		{
			"type": "kernel",
			"key": "|  kernel |",
			"keyColor": "magenta",
		},
		{
			"type": "packages",
			"key": "|  pkgs   |",
			"keyColor": "yellow",
		},
		{
			"type": "wm",
			"key": "| 󰙀 wm     |",
			"keyColor": "cyan",
		},
		{
			"type": "terminal",
			"key": "|  term   |",
			"keyColor": "green",
		},		
		{
			"type": "memory",
			"key": "|   ram   |",
			"keyColor": "blue",
		},
		{
			"type": "disk",
			"key": "|  disk   |",
			"keyColor": "yellow",
		},
		{
    		"type": "disk",
    		"key": "| 󰃰 os age |",
    		"keyColor": "red",
    		"folders": "/",
    		"format": "{days} days"
		},
		"separator",
		{
			"type": "colors",
			"key": "|  colors |",
			"keyColor": "magenta",
			"symbol": "circle",
		},
		"separator",
		
	],
}

		
